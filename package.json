{
  "name": "dsh-question-splitter",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "DSH 插件：识别图片中的题号（1. 2. 3.、(1)、第1题），把整页题目自动切成单题图片并保存到桌面。本地 OCR 优先，手写内容可用 AI 视觉辅助。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ocr",
    "question-splitter"
  ],
  "license": "MIT"
}
